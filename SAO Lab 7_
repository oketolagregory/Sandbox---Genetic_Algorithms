47\"/>\n     </g>\n    </g>\n   </g>\n  </g>\n </g>\n <defs>\n  <clipPath id=\"pc83a930ad4\">\n   <rect x=\"42.620313\" y=\"10.999219\" width=\"279\" height=\"277.2\"/>\n  </clipPath>\n </defs>\n</svg>\n"},"metadata":{}}]},{"cell_type":"code","source":[" def update(particles, global_best, w, c1, c2):\n","\n","  # Compute the velocities of the particles.\n","  velocities = w * particles.velocities + c1 * (particles.personal_best - particles.positions) + c2 * (global_best - particles.positions)\n","\n","  # Clamp the velocities to the range [-1, 1].\n","  velocities = np.clip(velocities, -1, 1)\n","\n","  # Update the positions of the particles.\n","  particles.positions += velocities\n","\n","  return particles"],"metadata":{"id":"kOui-rbGM3KP","executionInfo":{"status":"ok","timestamp":1699873334001,"user_tz":0,"elapsed":251,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}}},"execution_count":20,"outputs":[]},{"cell_type":"markdown","source":["##  Simple Particle Swarm Optimization (PSO) with Python\n"],"metadata":{"id":"7Kd1kmfYIzA2"}},{"cell_type":"code","source":[],"metadata":{"id":"OkiyrhJSIyXa"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["#------------------------------------------------------------------------------+\n","#   Nathan A. Rooy\n","#   Simple Particle Swarm Optimization (PSO) with Python\n","#   July, 2016\n","#\n","#------------------------------------------------------------------------------+\n","\n","#--- IMPORT DEPENDENCIES ------------------------------------------------------+\n","\n","from __future__ import division\n","import random\n","import math\n","\n","#--- COST FUNCTION ------------------------------------------------------------+\n","\n","# function we are attempting to optimize (minimize)\n","def func1(x):\n","    total=0\n","    for i in range(len(x)):\n","        total+=x[i]**2\n","    return total\n","\n","#--- MAIN ---------------------------------------------------------------------+\n","\n","class Particle:\n","    def __init__(self,x0):\n","        self.position_i=[]          # particle position\n","        self.velocity_i=[]          # particle velocity\n","        self.pos_best_i=[]          # best position individual\n","        self.err_best_i=-1          # best error individual\n","        self.err_i=-1               # error individual\n","\n","        for i in range(0,num_dimensions):\n","            self.velocity_i.append(random.uniform(-1,1))\n","            self.position_i.append(x0[i])\n","\n","    # evaluate current fitness\n","    def evaluate(self,costFunc):\n","        self.err_i=costFunc(self.position_i)\n","\n","        # check to see if the current position is an individual best\n","        if self.err_i < self.err_best_i or self.err_best_i==-1:\n","            self.pos_best_i=self.position_i\n","            self.err_best_i=self.err_i\n","\n","    # update new particle velocity\n","    def update_velocity(self,pos_best_g):\n","        w=0.5       # constant inertia weight (how much to weigh the previous velocity)\n","        c1=1        # cognative constant\n","        c2=2        # social constant\n","\n","        for i in range(0,num_dimensions):\n","            r1=random.random()\n","            r2=random.random()\n","\n","            vel_cognitive=c1*r1*(self.pos_best_i[i]-self.position_i[i])\n","            vel_social=c2*r2*(pos_best_g[i]-self.position_i[i])\n","            self.velocity_i[i]=w*self.velocity_i[i]+vel_cognitive+vel_social\n","\n","    # update the particle position based off new velocity updates\n","    def update_position(self,bounds):\n","        for i in range(0,num_dimensions):\n","            self.position_i[i]=self.position_i[i]+self.velocity_i[i]\n","\n","            # adjust maximum position if necessary\n","            if self.position_i[i]>bounds[i][1]:\n","                self.position_i[i]=bounds[i][1]\n","\n","            # adjust minimum position if neseccary\n","            if self.position_i[i] < bounds[i][0]:\n","                self.position_i[i]=bounds[i][0]\n","\n","class PSO():\n","    def __init__(self,costFunc,x0,bounds,num_particles,maxiter):\n","        global num_dimensions\n","\n","        num_dimensions=len(x0)\n","        err_best_g=-1                   # best error for group\n","        pos_best_g=[]                   # best position for group\n","\n","        # establish the swarm\n","        swarm=[]\n","        for i in range(0,num_particles):\n","            swarm.append(Particle(x0))\n","\n","        # begin optimization loop\n","        i=0\n","        while i < maxiter:\n","            #print i,err_best_g\n","            # cycle through particles in swarm and evaluate fitness\n","            for j in range(0,num_particles):\n","                swarm[j].evaluate(costFunc)\n","\n","                # determine if current particle is the best (globally)\n","                if swarm[j].err_i < err_best_g or err_best_g == -1:\n","                    pos_best_g=list(swarm[j].position_i)\n","                    err_best_g=float(swarm[j].err_i)\n","\n","            # cycle through swarm and update velocities and position\n","            for j in range(0,num_particles):\n","                swarm[j].update_velocity(pos_best_g)\n","                swarm[j].update_position(bounds)\n","            i+=1\n","\n","        # print final results\n","        print ('FINAL:')\n","        print (pos_best_g)\n","        print (err_best_g)\n","\n","if __name__ == \"__PSO__\":\n","    main()\n","\n","#--- RUN ----------------------------------------------------------------------+\n","\n","initial=[5,5]               # initial starting location [x1,x2...]\n","bounds=[(-10,10),(-10,10)]  # input bounds [(x1_min,x1_max),(x2_min,x2_max)...]\n","PSO(func1,initial,bounds,num_particles=15,maxiter=30)\n","\n","#--- END ----------------------------------------------------------------------+"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nd4jYsGhEc8o","executionInfo":{"status":"ok","timestamp":1700071088543,"user_tz":0,"elapsed":267,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}},"outputId":"451b3895-35d6-4c74-ff86-01cb04e1ba7e"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["FINAL:\n","[-9.64695757752548e-05, 0.0001876231134038276]\n","4.4508811733603186e-08\n"]},{"output_type":"execute_result","data":{"text/plain":["<__main__.PSO at 0x7a48ae0def20>"]},"metadata":{},"execution_count":3}]},{"cell_type":"code","source":["import numpy as np\n","\n","class Particle:\n","  \"\"\"A particle in a PSO swarm.\"\"\"\n","\n","  def __init__(self, n_dimensions):\n","    self.position = np.random.rand(n_dimensions)\n","    self.velocity = np.zeros(n_dimensions)\n","    self.personal_best = self.position.copy()\n","\n","  def update(self, global_best, w, c1, c2):\n","    \"\"\"Updates the position and velocity of the particle.\"\"\"\n","\n","    # Compute the new velocity.\n","    new_velocity = w * self.velocity + c1 * (self.personal_best - self.position) + c2 * (global_best - self.position)\n","\n","    # Clamp the velocity to the range [-1, 1].\n","    new_velocity = np.clip(new_velocity, -1, 1)\n","\n","    # Update the position of the particle.\n","    self.position += new_velocity\n","\n","    # Update the personal best position of the particle.\n","    if f(self.position) < f(self.personal_best):\n","      self.personal_best = self.position.copy()\n","\n","class PSO:\n","  \"\"\"A particle swarm optimization (PSO) algorithm.\"\"\"\n","\n","  def __init__(self, n_particles, n_dimensions, w, c1, c2):\n","    self.n_particles = n_particles\n","    self.n_dimensions = n_dimensions\n","    self.w = w\n","    self.c1 = c1\n","    self.c2 = c2\n","\n","    # Initialize the particles.\n","    self.particles = []\n","    for i in range(self.n_particles):\n","      self.particles.append(Particle(self.n_dimensions))\n","\n","    # Initialize the global best position.\n","    self.global_best = self.particles[0].personal_best.copy()\n","\n","  def optimize(self, max_iterations):\n","    \"\"\"Optimizes the cost function for the given number of iterations.\"\"\"\n","\n","    for i in range(max_iterations):\n","\n","      # Update the particles.\n","      for particle in self.particles:\n","        particle.update(self.global_best, self.w, self.c1, self.c2)\n","\n","      # Update the global best position.\n","      for particle in self.particles:\n","        if f(particle.position) < f(self.global_best):\n","          self.global_best = particle.position.copy()\n","\n","    return self.global_best\n","\n","# Define the cost function.\n","def f(x, y):\n","  return x**2 + (y + 1)**2 - 7.5 * np.cos(x + 1) - 3 * np.cos(2 * y - 1.5)\n","\n","# Create a PSO object.\n","pso = PSO(n_particles=10, n_dimensions=2, w=0.7298, c1=1.4962, c2=1.4962)\n","\n","# Optimize the cost function for 100 iterations.\n","global_best = pso.optimize(max_iterations=100)\n","\n","# Print the global best solution.\n","print(global_best)\n"],"metadata":{"id":"1G9FmE_7N9kr"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# WEEK 6\n"],"metadata":{"id":"eEAXTjEXMw1y"}},{"cell_type":"markdown","source":["Develop a subfuntion using Python to calculate the Probability\n"],"metadata":{"id":"zUTj3j-vIbZ6"}},{"cell_type":"code","execution_count":null,"metadata":{"id":"qKFc0zKKIPXN"},"outputs":[],"source":["def rank_weight (Nkeep):\n","  result = []\n","  for i in range(1,Nkeep + 1):\n","    p = (Nkeep - i + 1)/sum(range(1,Nkeep+1))\n","    result.append(p)\n","  return result\n"]},{"cell_type":"code","source":["print(rank_weight(6))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"01eTbgMTLCin","executionInfo":{"status":"ok","timestamp":1698662537406,"user_tz":0,"elapsed":227,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}},"outputId":"217e7499-f779-44b1-c87e-86a46f97bc52"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["[0.2857142857142857, 0.23809523809523808, 0.19047619047619047, 0.14285714285714285, 0.09523809523809523, 0.047619047619047616]\n"]}]},{"cell_type":"markdown","source":[" Develop a subfunction of blending method crossover using Python."],"metadata":{"id":"tobxa80zOrhl"}},{"cell_type":"code","source":["def crossover_blending(B):\n","  Pmn = [7.577, 3.1710]\n","  Pdn = [2.762, 8.8687]\n","\n","  Pnew = B * Pmn[:-1] + (1 - B) * Pdn[:-1]\n","  return Pnew"],"metadata":{"id":"HWcUZomUPlJV"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import random\n","\n","def crossover_blending(B):\n","    # Define father and mother chromosomes\n","    Pmn = [7.577, 3.1710]\n","    Pdn = [2.762, 8.8687]\n","\n","    # Generate a random blending factor if not provided\n","    if B is None:\n","        B = random.uniform(0, 1)\n","\n","    # Perform crossover blending\n","    Pnew = [B * Pmn[i] + (1 - B) * Pdn[i] for i in range(len(Pmn))]\n","\n","    return Pnew"],"metadata":{"id":"FHrQCuoNLX-s"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Example usage:\n","random_B = random.uniform(0, 1)  # Or you can specify B as needed\n","result = crossover_blending(random_B)\n","print(f\"Crossover Blending Result: {result}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"dBBz6RfMR4bC","executionInfo":{"status":"ok","timestamp":1698664261912,"user_tz":0,"elapsed":260,"user":{"displayName":"Gregory Oketola","userId":"13053235490742358740"}},"outputId":"1ea08b86-6896-4ff7-884d-98a6ebcdaac7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Crossover Blending Result: [3.369190191322437, 8.150197912129212]\n"]}]}]}